# Local Postgres (see docker-compose.yml). On Heroku this is set for you.
DATABASE_URL=postgres://freedom:freedom@localhost:5432/freedom_cc

# Any long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-only-change-me

# Public base URL of the app
APP_URL=http://localhost:3000

# Email (optional). Without it, all emails (waiver receipts, invites, password
# resets) are printed to the server console and logged to email_outbox instead
# of sent — the app still works, invited players just need the temp password
# relayed to them by the admin.
#
# Recommended free provider: Brevo (300 emails/day, no card needed) — see
# README.md "Email (free)" for setup. Discrete vars avoid URL-encoding the
# password, which is the usual way SMTP_URL setups go wrong:
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-login-email@example.com
# SMTP_PASS=your-brevo-smtp-key
# MAIL_FROM=Freedom CC <your-verified-sender@example.com>
#
# Alternative: a single connection string (any SMTP provider)
# SMTP_URL=smtp://user:pass@smtp.example.com:587
