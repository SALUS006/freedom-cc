# Local Postgres (see docker-compose.yml). On Heroku this is set for you.
DATABASE_URL=postgres://freedom:freedom@localhost:5432/freedom_cc

# Any long random string. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-only-change-me

# Public base URL of the app
APP_URL=http://localhost:3000

# Email (optional). Without it, invite emails are printed to the server console
# and their temporary passwords are shown to the admin to relay manually.
# Use a SendGrid / Mailgun / Postmark SMTP string, e.g.
# SMTP_URL=smtp://apikey:SG.xxxx@smtp.sendgrid.net:587
# MAIL_FROM=Freedom CC <no-reply@yourclub.example>
